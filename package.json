{
  "name": "baiagent-distribution",
  "version": "0.1.0",
  "description": "Local-first агент распространения: исследование продукта, каналы, бартер, автопилот и машинный outbox.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": {
    "name": "Баланов Антон Николаевич"
  },
  "homepage": "https://github.com/Balanov/baiagent-distribution",
  "license": "AGPL-3.0-or-later",
  "desktopName": "baiagent-distribution.desktop",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && node scripts/dist-win.mjs",
    "dist:win:signed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-windows-signing.ps1 && npm run build && node scripts/dist-win.mjs --signed",
    "dist:win:store": "npm run build && node scripts/dist-win.mjs --store",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "node-llama-cpp": "^3.22.2",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.0.1"
  },
  "overrides": {
    "simple-git": "4.0.2"
  },
  "build": {
    "appId": "pro.balanov.baiagent.distribution",
    "productName": "BAIagent Distribution",
    "asarUnpack": [
      "node_modules/node-llama-cpp/**/*",
      "node_modules/@node-llama-cpp/**/*"
    ],
    "files": [
      "dist/**/*",
      "!dist/downloads/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "executableName": "BAIagent Distribution",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "legalTrademarks": "BAIagent; A2OS",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": true
    },
    "appx": {
      "applicationId": "BAIagentDistribution",
      "publisherDisplayName": "Баланов Антон Николаевич",
      "displayName": "BAIagent Distribution",
      "backgroundColor": "#F4F8FF",
      "showNameOnTiles": true,
      "languages": [
        "ru-RU"
      ],
      "capabilities": [
        "runFullTrust",
        "internetClient",
        "privateNetworkClientServer"
      ],
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.28020.0",
      "artifactName": "BAIagent-Distribution-Store-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Баланов Антон Николаевич",
      "syncDesktopName": true,
      "artifactName": "BAIagent-Distribution-Linux-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "artifactName": "BAIagent-Distribution-macOS-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BAIagent Distribution",
      "menuCategory": "BAIagent",
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "artifactName": "BAIagent-Distribution-Setup-Windows-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "BAIagent-Distribution-Portable-Windows-${version}-${arch}.${ext}"
    }
  }
}
